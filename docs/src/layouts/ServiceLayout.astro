---
// Plantilla de página de servicio, simplificada: migas, hero, resumen corto, caso, FAQ breve y contacto.
// Slot opcional para secciones propias de una página: after-hero
import BaseLayout from './BaseLayout.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import CaseHighlight from '../components/service/CaseHighlight.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactSection from '../components/ContactSection.astro';
import type { Crumb } from '../components/Breadcrumbs.astro';
import { SIN_PERMANENCIA, type Service } from '../data/services';
import { SITE } from '../config/site';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const site = Astro.site!;
const url = new URL(`/${service.slug}/`, site).href;

const parent: Crumb =
  service.parent === '360' && service.slug !== 'servicios-360'
    ? { label: 'Servicios 360', href: '/servicios-360/' }
    : { label: 'Paid Media', href: '/#servicios' };

const crumbs: Crumb[] =
  service.slug === 'servicios-360'
    ? [{ label: 'Inicio', href: '/' }, { label: service.breadcrumb }]
    : [{ label: 'Inicio', href: '/' }, parent, { label: service.breadcrumb }];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.eyebrow,
    serviceType: service.serviceType,
    description: service.description,
    url,
    areaServed: { '@type': 'Country', name: 'España' },
    provider: {
      '@type': 'Person',
      name: SITE.name,
      jobTitle: SITE.jobTitle,
      url: new URL('/', site).href,
      sameAs: [SITE.linkedin],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    // "Paid Media" no tiene página propia (enlaza a una sección de la home): no entra en el JSON-LD
    itemListElement: crumbs.filter((c) => !c.href?.startsWith('/#')).map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: c.href ? new URL(c.href.split('#')[0], site).href : url,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout title={service.seoTitle} description={service.description} jsonLd={jsonLd} hasContactForm>
  <ServiceHero service={service} crumbs={crumbs} />

  <slot name="after-hero" />

  {
    service.summary && (
      <section class="section section--surface">
        <div class="container summary">
          <p class="text summary__text">{service.summary}</p>
          <p class="text-sm summary__note">{SIN_PERMANENCIA}</p>
        </div>
      </section>
    )
  }

  {service.caseStudy ? <CaseHighlight caseKey={service.caseStudy} /> : <div class="spacer" />}

  <FaqSection title={service.faq.title} items={service.faq.items.slice(0, 3)} class="section--flush-top" />

  <ContactSection
    title={service.contact.title}
    text={service.contact.text}
    defaultTipo={service.contact.defaultTipo}
    auditoriaLabel={service.contact.auditoriaLabel}
    investmentRequired={false}
  />
</BaseLayout>

<style>
  .spacer {
    height: var(--section-y);
  }

  .summary {
    max-width: 640px;
  }

  .summary__text {
    font-size: 18px;
    line-height: 1.6;
  }

  .summary__note {
    margin-top: 14px;
    color: var(--muted);
  }
</style>
