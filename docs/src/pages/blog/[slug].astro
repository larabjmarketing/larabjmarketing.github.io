---
// Plantilla de artículo (design/Blog-articulo.dc.html): cabecera, portada o diagrama, índice lateral,
// "Resumen rápido", cuerpo MDX con figura y CTA intermedio, FAQ, ficha de autora, relacionados y CTA final.
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import BarCover from '../../components/blog/BarCover.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import Figure from '../../components/blog/Figure.astro';
import MidCta from '../../components/blog/MidCta.astro';
import CtaBand from '../../components/CtaBand.astro';
import lara from '../../assets/img/lara-borrego-freelance-paid-media.jpg';
import { SITE, whatsappUrl } from '../../config/site';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { contactHref } from '../../lib/contact';
import { getPosts, postUrl, formatLongDate, isoDate, type Post } from '../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const { data } = post;
const { Content, headings } = await render(post);

const related = (await getPosts()).filter((p) => p.id !== post.id).slice(0, 3);

const toc = [
  { id: 'resumen', text: 'Resumen rápido' },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
  { id: 'preguntas-frecuentes', text: 'Preguntas frecuentes' },
];

const site = Astro.site!;
const url = new URL(postUrl(post), site).href;
const shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
const ogImage = await getImage({ src: data.image, width: 1200, format: 'jpg' });

const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: data.category },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    datePublished: isoDate(data.date),
    dateModified: isoDate(data.date),
    inLanguage: 'es-ES',
    mainEntityOfPage: url,
    image: new URL(ogImage.src, site).href,
    articleSection: data.category,
    author: {
      '@type': 'Person',
      name: SITE.name,
      jobTitle: SITE.jobTitle,
      url: new URL('/', site).href,
      sameAs: [SITE.linkedin],
    },
    publisher: { '@type': 'Person', name: SITE.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site).href },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title={`${data.shortTitle} | Blog Lara Borrego`}
  description={data.description}
  image={data.image}
  imageAlt={data.imageAlt}
  type="article"
  publishedTime={data.date}
  jsonLd={jsonLd}
>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <header class="a-head">
    <div class="container a-head__inner">
      <Breadcrumbs items={crumbs} />
      <span class="pill">{data.category}</span>
      <h1 class="a-head__title">{data.title}</h1>
      <p class="lead a-head__lead">{data.description}</p>
      <div class="byline">
        <Image src={lara} alt="" width={72} height={72} loading="eager" class="byline__avatar" />
        <div>
          <p class="byline__name">Lara Borrego</p>
          <p class="byline__meta">
            <time datetime={isoDate(data.date)}>{formatLongDate(data.date)}</time> · {data.readingTime} min de lectura
          </p>
        </div>
      </div>
    </div>
  </header>

  <div class="container a-visual">
    {
      data.flow ? (
        <ol class="flow on-dark" role="list" aria-label="Cómo funciona">
          {data.flow.map((s, i) => (
            <li class:list={['flow__step', { 'flow__step--last': i === data.flow!.length - 1 }]} style={`--i: ${i}`}>
              <span class="flow__label">{s.step}</span>
              <span class="flow__text">{s.text}</span>
            </li>
          ))}
        </ol>
      ) : (
        <BarCover tone={data.cover.tone} bars={data.cover.bars} height="280px" class="a-cover" />
      )
    }
  </div>

  <div class="container a-body">
    <aside class="a-aside">
      <nav class="toc" aria-label="En este artículo">
        <details class="toc__details" open data-toc-details>
          <summary class="label toc__title">En este artículo</summary>
          <ol role="list">
            {
              toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} data-toc-link>
                    {item.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </details>
      </nav>

      <div class="side-cta on-dark">
        <p class="side-cta__title">{data.sidebarCta.title}</p>
        <p class="side-cta__text">{data.sidebarCta.text}</p>
        <Button href={contactHref('llamada', false)} tipo="llamada" icon="calendar" size="sm" block>Reservar llamada</Button>
        <a href={whatsappUrl()} class="side-cta__wa" target="_blank" rel="noopener" data-whatsapp>
          <WhatsAppIcon size={18} /> O por WhatsApp<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
        </a>
      </div>

      <div class="share">
        <p class="label">Compartir</p>
        <div class="share__row">
          <a href={shareUrl} target="_blank" rel="noopener" class="share__btn">
            LinkedIn<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
          </a>
          <button type="button" class="share__btn" data-copy={url}>Copiar enlace</button>
        </div>
      </div>
    </aside>

    <article class="prose" data-article>
      <div id="resumen" class="summary">
        <p class="label">Resumen rápido</p>
        {
          data.summary.map((s) => (
            <p>
              <strong>{s.label}:</strong> {s.text}
            </p>
          ))
        }
      </div>

      <Content components={{ Figure, MidCta }} />

      <h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>
      <div class="a-faq">
        {
          data.faq.map((item) => (
            <div class="a-faq__item">
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </div>
          ))
        }
      </div>

      {
        data.sources.length > 0 && (
          <p class="sources">
            Fuentes:{' '}
            {data.sources.map((s, i) => (
              <>
                <a href={s.href} target="_blank" rel="noopener">
                  {s.label}
                </a>
                {i < data.sources.length - 1 ? ', ' : '.'}
              </>
            ))}
          </p>
        )
      }

      <a href={data.service.href} class="service-link">
        <span class="label">¿Prefieres que lo haga yo?</span>
        <span class="service-link__title">{data.service.label}</span>
      </a>

      <div class="author">
        <Image src={lara} alt="Lara Borrego" width={160} height={160} class="author__photo" />
        <div class="author__copy">
          <p class="label">Sobre la autora</p>
          <p class="author__name">Lara Borrego</p>
          <p class="author__bio">
            Freelance de paid media con más de 8 años en Google Ads, Meta Ads y programática. Docente de IA aplicada a la
            publicidad en KSchool y de programática en el Máster de EPMD.
          </p>
          <a href={SITE.linkedin} target="_blank" rel="noopener" class="link-arrow">
            LinkedIn<span class="visually-hidden"> de Lara Borrego (se abre en una pestaña nueva)</span>
          </a>
        </div>
      </div>
    </article>
  </div>

  <section class="section section--flush-top">
    <div class="container">
      <h2 class="related__title">Sigue leyendo</h2>
      <div class="grid grid--3">
        {related.map((p) => <ArticleCard post={p} />)}
      </div>
    </div>
  </section>

  <CtaBand title={data.finalCta.title} text={data.finalCta.text} />

  <dialog class="lightbox" data-lightbox aria-label="Imagen ampliada">
    <form method="dialog">
      <button class="lightbox__close" aria-label="Cerrar imagen">×</button>
    </form>
    <img src="" alt="" data-lightbox-img />
  </dialog>
</BaseLayout>

<style>
  /* Barra de progreso de lectura */
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 3px;
    pointer-events: none;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  /* Cabecera */
  .a-head {
    padding-block: 56px 40px;
  }

  .a-head__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }

  .pill {
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--accent-tint);
    color: var(--accent-dark);
    font-size: var(--fs-label);
    font-weight: 700;
  }

  .a-head__title {
    max-width: 980px;
    font-size: clamp(36px, 22px + 2.8vw, 60px);
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  .a-head__lead {
    max-width: 760px;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
  }

  .byline :global(.byline__avatar) {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    object-position: center 20%;
  }

  .byline__name {
    font-size: 14px;
    font-weight: 700;
  }

  .byline__meta {
    font-size: 13px;
    color: var(--muted-2);
  }

  /* Portada y diagrama */
  .a-visual {
    padding-bottom: 64px;
  }

  .a-visual :global(.a-cover) {
    border-radius: var(--radius-block);
  }

  .flow {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0;
    padding: 56px 72px;
    border-radius: var(--radius-block);
    background: var(--dark);
    color: var(--on-dark);
  }

  .flow__step {
    position: relative;
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    border-radius: var(--radius-card-sm);
    background: var(--dark-2);
    border: 1px solid var(--dark-border);
    animation: rise-in 0.7s var(--ease-out) backwards;
    animation-delay: calc(0.2s + var(--i) * 0.15s);
  }

  .flow__step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -20px;
    top: 50%;
    translate: 50% -50%;
    font-size: 24px;
    color: var(--accent-light);
    animation: nudge 1.8s ease-in-out infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateX(-3px);
    }
    50% {
      transform: translateX(3px);
    }
  }

  .flow__step--last {
    background: var(--accent);
    border-color: var(--accent);
  }

  .flow__label {
    font-size: 13px;
    color: var(--on-dark-muted);
  }

  .flow__step--last .flow__label {
    color: #fff;
  }

  .flow__text {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
  }

  /* Cuerpo */
  .a-body {
    display: grid;
    grid-template-columns: 300px minmax(0, 760px);
    justify-content: center;
    gap: 72px;
    align-items: start;
    padding-bottom: 80px;
  }

  .a-aside {
    position: sticky;
    top: 112px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .toc__details > summary {
    list-style: none;
    padding-bottom: 10px;
    color: var(--muted);
    cursor: default;
    pointer-events: none;
  }

  .toc__details > summary::-webkit-details-marker {
    display: none;
  }

  .toc ol {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
  }

  .toc a {
    display: block;
    padding: 8px 0 8px 14px;
    border-left: 2px solid var(--border);
    font-size: 15px;
    line-height: 1.4;
    font-weight: 500;
    color: var(--muted);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      padding 0.2s ease;
  }

  .toc a:hover {
    color: var(--accent-dark);
    padding-left: 18px;
  }

  .toc a.is-active {
    border-left-color: var(--accent);
    color: var(--accent-dark);
    font-weight: 700;
  }

  .side-cta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px;
    border-radius: var(--radius-card);
    background: var(--dark);
    color: var(--on-dark);
  }

  .side-cta__title {
    font-size: 19px;
    font-weight: 800;
    line-height: 1.25;
  }

  .side-cta__text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--on-dark-muted);
  }

  .side-cta__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--on-dark-2);
  }

  .side-cta__wa:hover {
    color: var(--accent-light);
  }

  .share {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .share .label {
    color: var(--muted);
  }

  .share__row {
    display: flex;
    gap: 8px;
  }

  .share__btn {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .share__btn:hover,
  .share__btn.is-done {
    border-color: var(--accent);
    color: var(--accent-dark);
  }

  /* Texto del artículo */
  .prose {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }

  /* Solo los párrafos del cuerpo (hijos directos): no afecta al CTA intermedio ni a otras piezas */
  .prose > :global(p) {
    font-size: 18px;
    line-height: 1.75;
    color: #27272a;
  }

  .prose :global(h2) {
    scroll-margin-top: 110px;
    margin-top: 16px;
    font-size: clamp(26px, 22px + 0.8vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .prose :global(strong) {
    font-weight: 700;
    color: var(--ink);
  }

  .prose :global(p a),
  .sources a {
    font-weight: 700;
    color: var(--accent-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card-sm);
    background: var(--surface);
    font-size: 16px;
  }

  .prose :global(th) {
    padding: 14px 22px;
    background: var(--surface-2);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
  }

  .prose :global(td) {
    padding: 16px 22px;
    border-top: 1px solid var(--border);
    line-height: 1.5;
  }

  .prose :global(td:last-child) {
    font-weight: 800;
    color: var(--accent-dark);
    white-space: nowrap;
  }

  .prose :global(tbody tr) {
    transition: background-color 0.2s ease;
  }

  .prose :global(tbody tr:hover) {
    background: var(--accent-tint);
  }

  .summary {
    scroll-margin-top: 110px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 32px;
    border-radius: var(--radius-card);
    background: var(--accent-tint);
    border: 1px solid var(--accent-border);
  }

  .summary .label {
    color: var(--accent-dark);
  }

  .prose .summary p:not(.label) {
    font-size: 17px;
    line-height: 1.65;
  }

  .a-faq {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .a-faq__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 26px;
    border-radius: var(--radius-card-sm);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .a-faq__item h3 {
    font-size: 18px;
    line-height: 1.4;
    font-weight: 700;
  }

  .prose .a-faq__item p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }

  .prose .sources {
    font-size: 15px;
    color: var(--muted);
  }

  .service-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px 28px;
    border-radius: var(--radius-card);
    background: var(--accent-tint);
    border: 1px solid var(--accent-border);
    transition: translate 0.2s ease;
  }

  .service-link:hover {
    translate: 0 -2px;
    color: var(--ink);
  }

  .service-link .label {
    color: var(--accent-dark);
  }

  .service-link__title {
    font-size: 19px;
    font-weight: 700;
  }

  .service-link__title::after {
    content: ' →';
    color: var(--accent-dark);
  }

  .author {
    display: flex;
    gap: 24px;
    align-items: center;
    margin-top: 16px;
    padding: 28px;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .author :global(.author__photo) {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    object-position: center 20%;
  }

  .author__copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .author .label {
    color: var(--muted);
  }

  .author__name {
    font-size: 18px;
    font-weight: 800;
  }

  .prose .author__bio {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .related__title {
    margin-bottom: 32px;
    font-size: 32px;
    letter-spacing: -0.02em;
  }

  /* Lightbox */
  .lightbox {
    max-width: min(1200px, 94vw);
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
  }

  .lightbox::backdrop {
    background: rgba(21, 20, 31, 0.8);
    backdrop-filter: blur(4px);
  }

  .lightbox[open] {
    animation: pop-in 0.3s var(--ease-out);
  }

  .lightbox img {
    display: block;
    max-width: 100%;
    max-height: 92vh;
  }

  .lightbox__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--dark);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .a-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .a-aside {
      position: static;
      max-width: 760px;
    }

    .toc {
      padding: 20px 24px;
      border-radius: var(--radius-card-sm);
      background: var(--surface);
      border: 1px solid var(--border);
    }

    .toc__details > summary {
      pointer-events: auto;
      cursor: pointer;
    }

    .toc__details > summary::after {
      content: ' +';
    }

    .toc__details[open] > summary::after {
      content: ' −';
    }

    .side-cta {
      display: none;
    }

    .flow {
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
      padding: 40px;
    }

    .flow__step:not(:last-child)::after {
      content: '↓';
      right: 50%;
      top: auto;
      bottom: -14px;
      translate: 50% 50%;
      animation: none;
    }
  }

  @media (max-width: 639px) {
    .a-head {
      padding-top: 32px;
      text-align: left;
    }

    .a-head__inner {
      align-items: flex-start;
      text-align: left;
    }

    .flow {
      padding: 28px 20px;
    }

    .summary {
      padding: 24px 20px;
    }

    .prose > :global(p) {
      font-size: 17px;
    }

    .prose :global(th),
    .prose :global(td) {
      padding: 12px 14px;
    }

    .author {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
    }
  }
</style>

<script>
  /* Barra de progreso */
  const article = document.querySelector<HTMLElement>('[data-article]');
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const updateProgress = () => {
    if (!article || !bar) return;
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight * 0.6;
    const p = Math.min(1, Math.max(0, -rect.top / Math.max(1, total)));
    bar.style.setProperty('--p', p.toFixed(3));
  };
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });

  /* Índice: resalta la sección visible */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const sections = links
    .map((l) => document.getElementById(decodeURIComponent(l.hash.slice(1))))
    .filter((el): el is HTMLElement => Boolean(el));

  const setActive = () => {
    const line = 140;
    let current = sections[0];
    sections.forEach((s) => {
      if (s.getBoundingClientRect().top - line <= 0) current = s;
    });
    links.forEach((l) => l.classList.toggle('is-active', decodeURIComponent(l.hash.slice(1)) === current?.id));
  };
  setActive();
  window.addEventListener('scroll', setActive, { passive: true });

  /* En tablet y móvil el índice empieza plegado */
  const details = document.querySelector<HTMLDetailsElement>('[data-toc-details]');
  if (details && window.matchMedia('(max-width: 1023px)').matches) details.open = false;

  /* Copiar enlace */
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? location.href);
        const label = btn.textContent;
        btn.textContent = 'Enlace copiado';
        btn.classList.add('is-done');
        setTimeout(() => {
          btn.textContent = label;
          btn.classList.remove('is-done');
        }, 2000);
      } catch {
        /* sin permiso de portapapeles: no hacemos nada */
      }
    });
  });

  /* Ampliar figuras */
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const dialogImg = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
  document.querySelectorAll<HTMLAnchorElement>('[data-zoom]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!dialog || !dialogImg || typeof dialog.showModal !== 'function') return;
      event.preventDefault();
      const img = link.querySelector('img');
      dialogImg.src = link.href;
      dialogImg.alt = img?.alt ?? '';
      dialog.showModal();
    });
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
