---
import Logo from './Logo.astro';
import { SITE, FOOTER_COLUMNS, LEGAL_LINKS } from '../config/site';

const year = new Date().getFullYear();
const isExternal = (href: string) => href.startsWith('http');
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo />
        <p>{SITE.tagline}</p>
        <a class="site-footer__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
      <nav class="site-footer__cols" aria-label="Pie de página">
        {
          FOOTER_COLUMNS.map((col) => (
            <div class="site-footer__col">
              <p class="site-footer__title">{col.label}</p>
              <ul role="list">
                {col.items.map((item) => (
                  <li>
                    {isExternal(item.href) ? (
                      <a href={item.href} target="_blank" rel="noopener">
                        {item.label}
                        <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
                      </a>
                    ) : (
                      <a href={item.href}>{item.label}</a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="site-footer__bottom">
      <p>© {year} {SITE.name}</p>
      <ul role="list" class="site-footer__legal">
        {
          LEGAL_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <button type="button" class="site-footer__cookies" data-cookie-settings>Configurar cookies</button>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 40px 32px;
    font-size: 15px;
    color: var(--muted);
  }

  .site-footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 48px;
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .site-footer__mail {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer__cols {
    display: flex;
    gap: 64px;
  }

  .site-footer__col ul,
  .site-footer__legal {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__title {
    margin-bottom: 10px;
    font-weight: 700;
    color: var(--ink);
  }

  .site-footer a {
    color: var(--muted);
  }

  .site-footer a:hover {
    color: var(--accent-dark);
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .site-footer__cookies {
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: inherit;
    cursor: pointer;
  }

  .site-footer__cookies:hover {
    color: var(--accent-dark);
  }

  @media (max-width: 1023px) {
    .site-footer__top {
      flex-direction: column;
    }
  }

  @media (max-width: 639px) {
    .site-footer__cols {
      flex-direction: column;
      gap: 28px;
    }
  }
</style>
