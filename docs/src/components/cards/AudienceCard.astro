---
// Tarjeta "Para quién": etiqueta, título y texto.
interface Props {
  label?: string;
  title: string;
  text: string;
}

const { label = 'Para', title, text } = Astro.props;
---

<div class="audience-card">
  <span class="label">{label}</span>
  <h3>{title}</h3>
  <p>{text}</p>
</div>

<style>
  .audience-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
  }

  .label {
    color: var(--accent-dark);
  }

  h3 {
    font-size: 24px;
    line-height: 1.25;
    font-weight: 800;
  }

  p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 639px) {
    .audience-card {
      padding: 24px;
    }
  }
</style>
