---
// Tarjeta de caso con cifra grande. Los clientes nunca se nombran.
interface Props {
  figure: string;
  figureLabel: string;
  title: string;
  text: string;
  meta: string;
}

const { figure, figureLabel, title, text, meta } = Astro.props;
---

<article class="case-card">
  <p class="case-card__figure">
    <span class="case-card__value">{figure}</span>
    <span class="case-card__unit">{figureLabel}</span>
  </p>
  <h3>{title}</h3>
  <p class="text-sm">{text}</p>
  <p class="case-card__meta">{meta}</p>
</article>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
  }

  .case-card__figure {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .case-card__value {
    font-size: 52px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .case-card__unit {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-2);
  }

  h3 {
    font-size: 19px;
    line-height: 1.3;
    font-weight: 700;
  }

  .case-card__meta {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--muted-2);
  }

  @media (max-width: 639px) {
    .case-card {
      padding: 24px;
    }
  }
</style>
