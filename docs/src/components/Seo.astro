---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultOgImage from '../assets/img/lara-borrego-freelance-paid-media-og.jpg';
import { SITE } from '../config/site';

// Etiquetas SEO de cada página: title, description, canonical, robots, Open Graph, Twitter Card y JSON-LD.
export interface SeoProps {
  title: string;
  description: string;
  /** Imagen para redes (se recorta a 1200x630). Por defecto, la foto de Lara. */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = defaultOgImage,
  imageAlt = 'Lara Borrego, freelance de paid media',
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props as SeoProps;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Proporción 1200x630 sin ampliar la imagen de origen si es más pequeña.
const ogWidth = Math.min(1200, image.width);
const ogHeight = Math.round((ogWidth * 630) / 1200);
const og = await getImage({ src: image, width: ogWidth, height: ogHeight, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site).href;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<meta property="og:type" content={type} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content={ogWidth} />
<meta property="og:image:height" content={ogHeight} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
