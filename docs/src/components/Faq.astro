---
// Lista de preguntas frecuentes desplegables. Cada pregunta es un H3 (sección 8 del brief).
// Las mismas `items` se usan para el JSON-LD FAQPage.
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  /** Cuántas preguntas aparecen abiertas al cargar. */
  openCount?: number;
}

const { items, openCount = 1 } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details class="faq__item" open={i < openCount}>
        <summary class="faq__summary">
          <h3 class="faq__q">{item.q}</h3>
          <span class="faq__sign" aria-hidden="true" />
        </summary>
        <p class="faq__a">{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq__item {
    border-radius: var(--radius-card-sm);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .faq__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 28px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-card-sm);
  }

  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font-size: 18px;
    line-height: 1.4;
    font-weight: 700;
  }

  .faq__summary:hover .faq__q {
    color: var(--accent-dark);
  }

  /* Signo + / − dibujado con CSS */
  .faq__sign {
    position: relative;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }

  .faq__sign::before,
  .faq__sign::after {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-dark);
    transition: transform 0.2s ease;
  }

  .faq__sign::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__sign::after {
    transform: rotate(0deg);
  }

  .faq__a {
    padding: 0 28px 24px;
    margin-top: -10px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
  }

  @media (max-width: 639px) {
    .faq__summary {
      padding: 20px;
    }

    .faq__a {
      padding: 0 20px 20px;
    }

    .faq__q {
      font-size: 17px;
    }
  }
</style>
