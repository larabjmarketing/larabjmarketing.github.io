---
// Tabla comparativa "Agencia típica vs conmigo". En móvil cada fila se convierte en tarjeta.
const rows = [
  { what: 'Quién toca tu cuenta', agency: 'Un junior con muchas cuentas', me: 'Yo, en persona' },
  { what: 'Plataformas', agency: 'Google y Meta, el resto se subcontrata', me: 'De Search a DV360 y CTV' },
  { what: 'Qué se mide', agency: 'Clics, CTR y conversiones de plataforma', me: 'Ventas, leads cualificados y margen' },
  { what: 'Web, analítica, CRM y marca', agency: '"No entra en el servicio"', me: 'Especialistas coordinados por mí' },
  { what: 'Propiedad de las cuentas', agency: 'A veces, de la agencia', me: 'Siempre tuyas' },
];
---

<section class="section section--flush-top">
  <div class="container">
    <h2 class="h2 h2--sm compare__title">¿Freelance o agencia? Esto es lo que cambia.</h2>
    <div class="compare">
      <table>
        <thead>
          <tr>
            <th scope="col">Qué recibes</th>
            <th scope="col">Agencia típica</th>
            <th scope="col" class="compare__me-head">Conmigo</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <th scope="row">{row.what}</th>
                <td class="compare__agency" data-label="Agencia típica">{row.agency}</td>
                <td class="compare__me" data-label="Conmigo">
                  <span class="accent" aria-hidden="true">✓ </span>
                  {row.me}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .compare__title {
    max-width: 760px;
    margin-bottom: 40px;
  }

  .compare {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 16px;
    text-align: left;
  }

  th,
  td {
    padding: 20px 18px;
    vertical-align: top;
    line-height: 1.5;
  }

  th:first-child,
  td:first-child {
    padding-left: 36px;
  }

  tr > :last-child {
    padding-right: 36px;
  }

  thead th {
    background: var(--surface-2);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  thead .compare__me-head {
    color: var(--accent-dark);
  }

  tbody tr {
    border-top: 1px solid var(--border);
  }

  tbody th,
  .compare__me {
    font-weight: 700;
  }

  .compare__agency {
    color: var(--muted);
  }

  @media (max-width: 639px) {
    .compare {
      overflow: visible;
      border: 0;
      background: none;
      box-shadow: none;
    }

    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    tbody {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    tbody tr {
      padding: 20px;
      border: 1px solid var(--border);
      border-radius: var(--radius-card-sm);
      background: var(--surface);
      box-shadow: var(--shadow-card);
    }

    th,
    td,
    th:first-child,
    td:first-child,
    tr > :last-child {
      padding: 0;
    }

    tbody th {
      margin-bottom: 12px;
      font-size: 17px;
    }

    td + td {
      margin-top: 10px;
    }

    td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 2px;
      font-size: var(--fs-label);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .compare__me::before {
      color: var(--accent-dark);
    }
  }
</style>
