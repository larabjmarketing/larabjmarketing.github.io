---
import Button from '../Button.astro';

// Informe de auditoría de ejemplo con barras.
// Los valores "[X] %" son marcadores del diseño: pendiente de que Lara decida qué mostrar.
const bars = [
  { label: 'Inversión sin retorno detectada', value: '[X] %', width: 32 },
  { label: 'Precisión de la medición', value: '[X] %', width: 61 },
  { label: 'Calidad de señales', value: '[X] %', width: 45 },
  { label: 'Estructura de campañas', value: '[X] %', width: 74 },
];
---

<div class="report">
  <div class="report__head">
    <p class="label">Informe de auditoría</p>
    <span class="report__badge">Ejemplo</span>
  </div>
  <ul class="report__bars" role="list">
    {
      bars.map((bar) => (
        <li>
          <div class="report__row">
            <span>{bar.label}</span>
            <strong>{bar.value}</strong>
          </div>
          <div class="report__track" aria-hidden="true">
            <div class="report__fill" style={`width: ${bar.width}%`} />
          </div>
        </li>
      ))
    }
  </ul>
  <Button href="?tipo=auditoria#contacto" tipo="auditoria" variant="ink" block>Pedir auditoría</Button>
</div>

<style>
  .report {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 32px;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-raised);
  }

  .report__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .report__head .label {
    color: var(--muted);
  }

  .report__badge {
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--accent-tint);
    color: var(--accent-dark);
    font-size: var(--fs-label);
    font-weight: 700;
  }

  .report__bars {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 0;
    padding: 0;
  }

  .report__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 8px;
    font-size: 15px;
  }

  .report__row span {
    font-weight: 600;
  }

  .report__track {
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--track);
  }

  .report__fill {
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--accent);
  }

  @media (max-width: 639px) {
    .report {
      padding: 24px 20px;
    }
  }
</style>
