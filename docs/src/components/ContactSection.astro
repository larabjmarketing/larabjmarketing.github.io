---
import { Image } from 'astro:assets';
import Eyebrow from './Eyebrow.astro';
import ContactForm from './ContactForm.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import lara from '../assets/img/lara-borrego-freelance-paid-media.jpg';
import { SITE, whatsappUrl } from '../config/site';
import { CONTACT_ID, type Tipo } from '../lib/contact';

// Bloque oscuro de contacto: cómo funciona (3 pasos), contacto directo (WhatsApp y email) y formulario.
// Lleva siempre id="contacto".
interface Props {
  title: string;
  text: string;
  defaultTipo?: Tipo;
  auditoriaLabel?: string;
  investmentRequired?: boolean;
}

const { title, text, defaultTipo, auditoriaLabel, investmentRequired } = Astro.props;

const steps = [
  { title: 'Me cuentas qué necesitas', text: 'Elige el tipo de ayuda y déjame tus datos.' },
  { title: 'Te respondo en 48 horas', text: 'Con lo que veo y con lo que haría primero.' },
  { title: 'Hablamos 30 minutos', text: 'Una llamada gratuita y sin compromiso para ver tu caso.' },
];
---

<section id={CONTACT_ID} class="contact">
  <div class="container">
    <div class="contact__box on-dark" data-contact-box>
      <span class="contact__glow" aria-hidden="true"></span>

      <div class="contact__intro">
        <Eyebrow tone="dark">Contacto</Eyebrow>
        <h2 class="h2">{title}</h2>
        <p class="text">{text}</p>

        <ol class="contact__steps" role="list">
          {
            steps.map((s, i) => (
              <li class="cstep" style={`--i: ${i}`}>
                <span class="cstep__num" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <p class="cstep__title">{s.title}</p>
                  <p class="cstep__text">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="direct">
          <div class="direct__who">
            <span class="direct__avatar">
              <Image src={lara} alt="" width={112} height={112} />
              <span class="direct__dot" aria-hidden="true"></span>
            </span>
            <div>
              <p class="direct__name">Lara Borrego</p>
              <p class="direct__role">Te respondo yo, en persona</p>
            </div>
          </div>
          <div class="direct__links">
            <a href={whatsappUrl()} class="direct__wa" target="_blank" rel="noopener" data-whatsapp>
              <WhatsAppIcon size={20} />
              WhatsApp<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
            </a>
            <a href={`mailto:${SITE.email}`} class="direct__mail">{SITE.email}</a>
          </div>
        </div>
      </div>

      <div class="contact__form">
        <ContactForm
          idPrefix="contacto"
          defaultTipo={defaultTipo}
          auditoriaLabel={auditoriaLabel}
          investmentRequired={investmentRequired}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 80px;
  }

  .contact__box {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 540px;
    align-items: start;
    gap: 64px;
    padding: 64px;
    border-radius: var(--radius-block-lg);
    background: var(--dark);
    color: var(--on-dark);
  }

  /* Luz que sigue al ratón por el bloque */
  .contact__glow {
    position: absolute;
    z-index: -1;
    left: var(--gx, 20%);
    top: var(--gy, 10%);
    width: 620px;
    height: 620px;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(13, 127, 113, 0.35), transparent);
    transition:
      left 0.8s var(--ease-out),
      top 0.8s var(--ease-out);
    pointer-events: none;
  }

  .contact__intro {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .contact__intro .h2 {
    line-height: 1.06;
  }

  /* Pasos */
  .contact__steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 6px 0 0;
    padding: 0;
  }

  .contact__steps::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 18px;
    bottom: 18px;
    width: 2px;
    background: linear-gradient(var(--accent-light), var(--dark-border));
    transform-origin: top;
  }

  :global(.js) .contact__steps:not(.is-visible)::before {
    transform: scaleY(0);
  }

  :global(.js) .contact__steps::before {
    transition: transform 1.2s var(--ease-out) 0.2s;
  }

  .cstep {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .cstep__num {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--dark-3);
    border: 1.5px solid var(--accent-light);
    color: var(--accent-light);
    font-weight: 800;
    font-size: 15px;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      scale 0.3s var(--ease-spring);
  }

  .cstep:hover .cstep__num {
    background: var(--accent-light);
    color: var(--dark);
    scale: 1.1;
  }

  :global(.js) .contact__steps:not(.is-visible) .cstep {
    opacity: 0;
    translate: -12px 0;
  }

  :global(.js) .cstep {
    transition:
      opacity 0.6s ease,
      translate 0.6s var(--ease-out);
    transition-delay: calc(0.25s + var(--i) * 0.2s);
  }

  .cstep__title {
    font-size: 17px;
    font-weight: 700;
  }

  .cstep__text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--on-dark-muted);
  }

  /* Contacto directo */
  .direct {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: 8px;
    padding: 18px 20px;
    border-radius: var(--radius-card-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--dark-border);
  }

  .direct__who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .direct__avatar {
    position: relative;
    flex-shrink: 0;
  }

  .direct__avatar :global(img) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    border: 2px solid var(--dark-border);
  }

  .direct__dot {
    position: absolute;
    right: 0;
    bottom: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent-light);
    border: 2px solid var(--dark);
  }

  .direct__dot::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--accent-light);
    animation: dot-ping 2s ease-out infinite;
  }

  @keyframes dot-ping {
    0% {
      opacity: 0.9;
      scale: 1;
    }
    80%,
    100% {
      opacity: 0;
      scale: 2.2;
    }
  }

  .direct__name {
    font-weight: 800;
  }

  .direct__role {
    font-size: 14px;
    color: var(--on-dark-muted);
  }

  .direct__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .direct__wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    background: #179447;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    transition:
      background-color 0.2s ease,
      translate 0.2s ease;
  }

  .direct__wa:hover {
    background: #127a3a;
    color: #fff;
    translate: 0 -2px;
  }

  .direct__mail {
    font-size: 14px;
    color: var(--on-dark-muted);
    text-decoration: underline;
    text-decoration-color: var(--dark-border);
    text-underline-offset: 4px;
  }

  .direct__mail:hover {
    color: var(--accent-light);
  }

  @media (max-width: 1179px) {
    .contact__box {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
      padding: 56px 48px;
    }

    .contact__form {
      max-width: 620px;
    }
  }

  @media (max-width: 639px) {
    .contact {
      padding-bottom: 48px;
    }

    .contact__box {
      padding: 36px 16px 16px;
      border-radius: var(--radius-block);
    }

    .contact__intro {
      padding-inline: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .direct__dot::after {
      display: none;
    }
  }
</style>

<script>
  // Luz que sigue al ratón dentro del bloque de contacto
  document.querySelectorAll<HTMLElement>('[data-contact-box]').forEach((box) => {
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    box.addEventListener('pointermove', (event) => {
      const rect = box.getBoundingClientRect();
      box.style.setProperty('--gx', `${((event.clientX - rect.left) / rect.width) * 100}%`);
      box.style.setProperty('--gy', `${((event.clientY - rect.top) / rect.height) * 100}%`);
    });
  });
</script>
