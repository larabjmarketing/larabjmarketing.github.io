---
import Eyebrow from '../Eyebrow.astro';
import Icon, { type IconName } from '../Icon.astro';
import { AREAS_360 } from '../../data/services';

// Detalle de cada área de Servicios 360. Cada bloque tiene su ancla (#analitica, #crm...).
const ICONS: Record<string, IconName> = {
  analitica: 'chart',
  'desarrollo-web': 'code',
  'ux-ui-cro': 'eye',
  'seo-geo': 'search',
  branding: 'pen',
  crm: 'flow',
  'social-media': 'megaphone',
};
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <Eyebrow>Áreas</Eyebrow>
      <h2 class="h2 h2--md">Qué hace cada especialista.</h2>
      <p class="text">Solo entra quien tu proyecto necesita y durante el tiempo que haga falta.</p>
    </div>
    <div class="areas grid grid--2">
      {
        AREAS_360.map((area) => (
          <article id={area.id} class="area">
            <div class="area__head">
              <span class="area__icon">
                <Icon name={ICONS[area.id]} size={22} />
              </span>
              <h3>{area.title}</h3>
            </div>
            <p class="text-sm">{area.text}</p>
            <p class="label area__label">Qué incluye</p>
            <ul role="list">
              {area.includes.map((item) => (
                <li>
                  <Icon name="check" size={15} strokeWidth={2.4} class="accent" />
                  {item}
                </li>
              ))}
            </ul>
            {'link' in area && area.link && (
              <a href={area.link.href} class="link-arrow">
                {area.link.label}
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .area {
    scroll-margin-top: 120px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
  }

  /* Con un número impar de áreas, la última ocupa todo el ancho */
  .area:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .area:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-tint), var(--shadow-raised);
  }

  .area:hover {
    border-color: var(--accent-border);
  }

  .area__head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .area__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--accent-tint);
    color: var(--accent-dark);
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      rotate 0.4s var(--ease-spring);
  }

  .area:hover .area__icon {
    background: var(--accent);
    color: #fff;
    rotate: -8deg;
  }

  h3 {
    font-size: 21px;
    line-height: 1.3;
    font-weight: 700;
  }

  .area__label {
    margin-top: 4px;
    color: var(--muted);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    font-size: 15px;
  }

  li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  li :global(svg) {
    flex-shrink: 0;
    margin-top: 4px;
  }

  .link-arrow {
    margin-top: auto;
    padding-top: 6px;
  }

  @media (max-width: 639px) {
    .area {
      padding: 24px;
    }
  }
</style>
