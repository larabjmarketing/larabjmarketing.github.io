---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Figura con pie de foto para los artículos (se usa dentro del MDX).
interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="figure">
  <a href={src.src} class="figure__zoom" data-zoom aria-label={`Ampliar imagen: ${alt}`}>
    <Image src={src} alt={alt} widths={[760, 1140, 1520]} sizes="(max-width: 820px) calc(100vw - 40px), 760px" />
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 8px 0;
  }

  .figure__zoom {
    display: block;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--border);
    box-shadow: 0 8px 28px rgba(17, 17, 20, 0.06);
    cursor: zoom-in;
  }

  .figure__zoom :global(img) {
    width: 100%;
    transition: scale 0.5s var(--ease-out);
  }

  .figure__zoom:hover :global(img) {
    scale: 1.02;
  }

  figcaption {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted-2);
  }
</style>
