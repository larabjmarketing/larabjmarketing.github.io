---
import Button from '../Button.astro';
import { contactHref } from '../../lib/contact';

// Llamada a la acción intermedia dentro de un artículo (se usa en el MDX).
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<aside class="mid-cta on-dark" aria-label="Llamada gratuita">
  <div>
    <p class="mid-cta__title">{title}</p>
    <p class="mid-cta__text">{text}</p>
  </div>
  <Button href={contactHref('llamada', false)} tipo="llamada" icon="calendar" class="mid-cta__btn">Reservar llamada</Button>
</aside>

<style>
  .mid-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin: 8px 0;
    padding: 28px 32px;
    border-radius: var(--radius-card);
    background: var(--dark);
    color: var(--on-dark);
  }

  .mid-cta > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mid-cta__title {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.3;
  }

  .mid-cta__text {
    font-size: 15px;
    color: var(--on-dark-muted);
  }

  .mid-cta :global(.mid-cta__btn) {
    flex-shrink: 0;
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .mid-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
    }
  }
</style>
