---
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { MAIN_NAV, isGroup, type NavLink } from '../config/site';
import { contactHref } from '../lib/contact';

interface Props {
  /** La página tiene su propio formulario de contacto (#contacto). */
  hasContactForm?: boolean;
}

const { hasContactForm = false } = Astro.props;
const path = Astro.url.pathname;

const isCurrent = (href: string) => !href.includes('#') && href === path;
const groupIsCurrent = (items: NavLink[]) => items.some((item) => item.href.split('#')[0] === path);

const callHref = contactHref('llamada', hasContactForm);
const auditHref = contactHref('auditoria', hasContactForm);
---

<header class="site-header">
  <div class="container">
    <nav class="nav" aria-label="Principal" data-nav>
      <Logo />

      <div class="nav__panel" id="nav-panel" data-nav-panel>
        <ul class="nav__list" role="list">
          {
            MAIN_NAV.map((entry, i) =>
              isGroup(entry) ? (
                <li class="nav__item nav__item--group" data-nav-group>
                  <button
                    type="button"
                    class:list={['nav__link', 'nav__trigger', { 'is-current': groupIsCurrent(entry.items) }]}
                    aria-expanded="false"
                    aria-controls={`nav-sub-${i}`}
                    data-nav-trigger
                  >
                    {entry.label}
                    <Icon name="chevron" size={16} class="nav__chevron" />
                  </button>
                  <ul class="nav__sub" id={`nav-sub-${i}`} role="list">
                    {entry.items.map((item) => (
                      <li>
                        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li class="nav__item">
                  <a
                    href={entry.href}
                    class:list={['nav__link', { 'is-current': isCurrent(entry.href) || (entry.href !== '/' && path.startsWith(entry.href) && !entry.href.includes('#')) }]}
                    aria-current={isCurrent(entry.href) ? 'page' : undefined}
                  >
                    {entry.label}
                  </a>
                </li>
              )
            )
          }
        </ul>
        <div class="nav__cta nav__cta--panel">
          <Button href={callHref} tipo="llamada" variant="outline-soft" size="sm">Llamada gratis 30 min</Button>
          <Button href={auditHref} tipo="auditoria" size="sm">Pide tu auditoría</Button>
        </div>
      </div>

      <div class="nav__cta nav__cta--bar">
        <Button href={callHref} tipo="llamada" variant="outline-soft" size="sm">Llamada gratis 30 min</Button>
        <Button href={auditHref} tipo="auditoria" size="sm">Pide tu auditoría</Button>
      </div>

      <button
        type="button"
        class="nav__toggle"
        aria-expanded="false"
        aria-controls="nav-panel"
        data-nav-toggle
      >
        <span class="visually-hidden" data-nav-toggle-label>Abrir menú</span>
        <Icon name="menu" size={22} class="nav__icon-open" />
        <Icon name="close" size={22} class="nav__icon-close" />
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: -8px;
    z-index: 50;
    padding-top: 20px;
  }

  .nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 68px;
    padding: 0 12px 0 28px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-float);
  }

  .nav__panel {
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 0;
    border: 0;
    background: none;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    cursor: pointer;
  }

  .nav__link:hover,
  .nav__link.is-current {
    color: var(--accent-dark);
  }

  .nav__link.is-current {
    font-weight: 700;
  }

  .nav__link :global(.nav__chevron) {
    transition: transform 0.2s ease;
  }

  .nav__trigger[aria-expanded='true'] :global(.nav__chevron) {
    transform: rotate(180deg);
  }

  .nav__sub {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__sub a {
    display: block;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }

  .nav__sub a:hover,
  .nav__sub a[aria-current='page'] {
    background: var(--accent-tint);
    color: var(--accent-dark);
  }

  .nav__sub a[aria-current='page'] {
    font-weight: 700;
  }

  .nav__cta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav__cta--bar {
    flex-shrink: 0;
  }

  .nav__cta--bar :global(.btn) {
    white-space: nowrap;
  }

  .nav__cta--panel {
    display: none;
  }

  .nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .nav__toggle :global(.nav__icon-close),
  .nav__toggle[aria-expanded='true'] :global(.nav__icon-open) {
    display: none;
  }

  .nav__toggle[aria-expanded='true'] :global(.nav__icon-close) {
    display: block;
  }

  /* Escritorio: desplegables flotantes */
  @media (min-width: 1340px) {
    .nav__sub {
      position: absolute;
      top: calc(100% + 14px);
      left: -18px;
      z-index: 10;
      min-width: 290px;
      padding: 10px;
      border-radius: var(--radius-card-sm);
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-pop);
    }

    /* Puente invisible para que el hover no se corte entre el botón y el panel */
    .nav__item--group::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 16px;
    }

    .nav__trigger[aria-expanded='true'] + .nav__sub {
      display: block;
    }

    @media (hover: hover) {
      .nav__item--group:hover .nav__sub {
        display: block;
      }
    }
  }

  /* Tablet y móvil: menú en panel desplegable */
  @media (max-width: 1339px) {
    .nav {
      padding: 0 10px 0 24px;
      gap: 12px;
    }

    .nav__toggle {
      display: inline-flex;
      order: 3;
    }

    .nav__cta--bar {
      margin-left: auto;
    }

    .nav__panel {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      max-height: calc(100vh - 110px);
      overflow-y: auto;
      padding: 20px;
      border-radius: var(--radius-card);
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-pop);
    }

    .nav__panel.is-open {
      display: flex;
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__item + .nav__item {
      border-top: 1px solid var(--border);
    }

    .nav__link {
      width: 100%;
      justify-content: space-between;
      padding: 14px 4px;
      font-size: 16px;
    }

    .nav__trigger[aria-expanded='true'] + .nav__sub {
      display: block;
      padding-bottom: 10px;
    }
  }

  @media (max-width: 639px) {
    .nav {
      min-height: 60px;
      padding: 0 8px 0 20px;
    }

    .nav__cta--bar {
      display: none;
    }

    .nav__toggle {
      margin-left: auto;
    }

    .nav__cta--panel {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .site-header {
      padding-top: 12px;
      top: -4px;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = nav?.querySelector<HTMLElement>('[data-nav-panel]');
  const toggleLabel = nav?.querySelector<HTMLElement>('[data-nav-toggle-label]');
  const triggers = nav ? [...nav.querySelectorAll<HTMLButtonElement>('[data-nav-trigger]')] : [];

  const closeSubmenus = (except?: HTMLButtonElement) => {
    triggers.forEach((t) => t !== except && t.setAttribute('aria-expanded', 'false'));
  };

  const setMenu = (open: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.classList.toggle('is-open', open);
    if (toggleLabel) toggleLabel.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    if (!open) closeSubmenus();
  };

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') !== 'true';
      closeSubmenus(trigger);
      trigger.setAttribute('aria-expanded', String(open));
    });
  });

  // Cerrar al pulsar un enlace del menú (incluidas anclas de la misma página)
  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenu(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const openTrigger = triggers.find((t) => t.getAttribute('aria-expanded') === 'true');
    if (openTrigger) {
      closeSubmenus();
      openTrigger.focus();
    } else if (toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (nav && !nav.contains(event.target as Node)) setMenu(false);
  });
</script>
