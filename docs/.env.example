# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# URL final del sitio, sin barra al final (canonical, Open Graph y sitemap)
SITE_URL=https://larabjmarketing.github.io

# Supabase. Usa la clave publicable/anon: la tabla está protegida con RLS.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Google Tag Manager, formato GTM-XXXXXXX
PUBLIC_GTM_ID=
